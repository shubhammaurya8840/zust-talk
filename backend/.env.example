NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:8081
DATABASE_URL="postgresql://postgres:Shubham@5017@localhost:5432/india_chat?schema=public"
JWT_ACCESS_SECRET="replace-with-a-long-random-secret-at-least-32-characters"
JWT_REFRESH_SECRET="replace-with-another-long-random-secret-at-least-32-characters"
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30
OTP_TTL_MINUTES=5
# Development only: returns OTP in the API response. Never enable in production.
DEV_RETURN_OTP=true
MAX_FILE_SIZE_MB=25
